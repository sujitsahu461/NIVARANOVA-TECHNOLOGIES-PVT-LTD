{
  "name": "nivaranova-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "test:security": "npm run audit && npm run build && playwright test security",
    "audit": "npm audit --audit-level=high",
    "generate:assets": "node scripts/generate-brand-assets.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run audit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Corporate website for NivaraNova Technologies",
  "engines": {
    "node": ">=20.19"
  }
}
