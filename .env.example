# Copy to .env.production (or set in your host's build settings).
# None of these are secrets: VITE_* values are compiled into public JavaScript.
# Never put API keys or passwords in a VITE_* variable.

# Canonical origin, no trailing slash. Enables canonical URLs, og:url and sitemap.xml.
VITE_SITE_URL=

# Optional. Your own HTTPS endpoint that receives the contact form as JSON.
# Leave empty to use Web3Forms (key in src/config/company.ts). If you set it,
# put its origin in connect-src in public/_headers.
VITE_CONTACT_ENDPOINT=

# Set to false to hide "to be added" placeholders for missing company details.
VITE_SHOW_PLACEHOLDERS=true
