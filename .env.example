# Build settings for the website.
#
# Copy this file to `.env` and fill in the values. `.env` is ignored by git, so
# keys stay off GitHub. On your host (Cloudflare Pages, Netlify), set the same
# variables in the project's build settings instead.
#
# Every VITE_* value is compiled into the public JavaScript, so anyone can read
# it in the browser. Only put values here that are safe to be public. Never put
# passwords, private API keys or tokens in a VITE_* variable.
#
# Keep this file committed and free of real values.

# Canonical origin, no trailing slash, e.g. https://www.example.in
# Enables canonical URLs, og:url and sitemap.xml.
VITE_SITE_URL=

# Web3Forms access key for the company inbox. Lets the contact form send
# directly. Without it, the form opens the visitor's email app instead.
# Get one at https://web3forms.com by entering the inbox address.
VITE_WEB3FORMS_ACCESS_KEY=

# Optional. Your own HTTPS endpoint that receives the contact form as JSON.
# Overrides Web3Forms. If you set it, put its origin in connect-src in
# public/_headers.
VITE_CONTACT_ENDPOINT=

# Set to false to hide "to be added" placeholders for missing company details.
VITE_SHOW_PLACEHOLDERS=true
