# Dependencies
node_modules

# Build output
dist
dist-ssr

# Test output
coverage
playwright-report
test-results

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files can hold keys. Only the empty template is committed.
.env
.env.*
!.env.example
*.local

# Keys, certificates and credentials. Never commit these.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
secrets/
.npmrc

# Hosting CLI state (can hold account tokens)
.netlify
.wrangler
.vercel

# Personal Claude Code settings (the shared launch.json is committed)
.claude/settings.local.json

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
